# Cloudflare Worker secrets (server). Gitignored. Used by `wrangler dev` locally;
# production copies are uploaded to Cloudflare with `npx wrangler secret put <NAME>`.

# Required: Clerk > Configure > API Keys > Secret key (same Clerk instance as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
CLERK_SECRET_KEY=

# AI. Set one. OPENAI_API_KEY takes priority when both are set.
# Prototype - Gemini 3.1 Flash-Lite: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Production - GPT-4o-mini: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only if selling Plus: Superwall > Integrations > Webhooks, endpoint https://<api>/webhooks/superwall.
# Paste the endpoint's signing secret (starts with whsec_). Every delivery's svix-* signature is checked.
SUPERWALL_WEBHOOK_SECRET=

# Share links on moments.vasemti.com (open the app from https links).
# Apple Developer > Membership > Team ID
APPLE_TEAM_ID=
# `eas credentials` > Android > SHA-256 fingerprint (comma-separate several)
ANDROID_CERT_SHA256=
# Store pages, once published
APP_STORE_URL=
PLAY_STORE_URL=
