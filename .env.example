# Copy to .env.local and fill in. Never commit real keys.

# Worker API and Clerk (existing)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (Project settings > API keys). Leave empty to keep billing off:
# the paywall then lets people carry on with Free.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# TURN relay for voice calls / live-room audio. Without it, calls often fail on cellular networks.
# Comma-separate multiple URLs, e.g. turn:host:3478?transport=udp,turns:host:5349?transport=tcp
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Worker secrets are set with wrangler, not here:
#   npx wrangler secret put REVENUECAT_WEBHOOK_SECRET   (same value as the webhook's Authorization header, without "Bearer ")
#   npx wrangler secret put ANTHROPIC_API_KEY
