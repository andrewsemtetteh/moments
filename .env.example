# Copy to .env.local and fill in. Never commit real keys.

# Worker API and Clerk (existing)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Superwall public API keys (Settings > Keys, one per app). Leave empty to keep billing off:
# the paywall then lets people carry on with Free. Needs a development / store build (no Expo Go).
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=
EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=
# The number in your App Store link (apps.apple.com/app/id<this>). "Rate Moments" opens the App Store review screen with it.
EXPO_PUBLIC_APP_STORE_ID=
# Entitlement: unlimited. Products: weekly, yearly, monthly (+ optional yearly_winback).
# Which paywall to show: native (ours, default) or superwall (the one designed in the dashboard,
# per placement; falls back to ours if none shows).
EXPO_PUBLIC_PAYWALL=native

# TURN relay for calls: set on the server only (wrangler secret put TURN_KEY_ID / TURN_KEY_API_TOKEN).
# Comma-separate multiple URLs, e.g. turn:host:3478?transport=udp,turns:host:5349?transport=tcp

# Server (Cloudflare Worker) secrets live in server/.dev.vars - see server/.dev.vars.example

# Crash reports (Sentry). The DSN is from Sentry > Project settings > Client keys.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (not EXPO_PUBLIC): uploads source maps so reports show real code.
# Set SENTRY_AUTH_TOKEN as an EAS secret (eas secret:create), never in the app.
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics (PostHog). Project API key and host from PostHog > Project settings.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# 1 to send events from development builds too (off by default).
EXPO_PUBLIC_POSTHOG_IN_DEV=
