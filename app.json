{
  "expo": {
    "name": "Moments",
    "slug": "moments",
    "owner": "andrewsemtetteh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "splash": {
      "image": "./assets/images/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "moments",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.vasemti.moments",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:moments.vasemti.com"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.vasemti.moments"
        ]
      }
    },
    "android": {
      "package": "com.vasemti.moments",
      "adaptiveIcon": {
        "backgroundColor": "#1F1B3A",
        "foregroundImage": "./assets/images/app-icon-android-foreground.png",
        "monochromeImage": "./assets/images/app-icon-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "moments.vasemti.com",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "moments.vasemti.com",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/moments-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-apple-authentication",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This only tells us which ads brought you to Moments, so we can stop paying for ones that don't work. It never touches your moments, messages or photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0E0E0E",
            "image": "./assets/images/splash-mark.png"
          },
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-mark.png",
            "imageWidth": 160,
            "dark": {
              "backgroundColor": "#0E0E0E",
              "image": "./assets/images/splash-mark.png"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Moments needs microphone access to record voice messages and calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Moments needs camera access for video calls and photo sharing.",
          "microphonePermission": "Moments needs microphone access for calls and voice messages.",
          "recordAudioAndroid": true
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "Moments needs photo access to share moments with your partner.",
          "cameraPermission": "Moments needs camera access to capture moments to share with your partner."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Moments needs access to save photos and videos to your gallery.",
          "savePhotosPermission": "Moments needs access to save photos and videos to your gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Moments uses location for location moments you choose to share."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Moments needs contacts access to share a contact in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF4D6D"
        }
      ],
      "expo-video",
      "@sentry/react-native",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Happy",
            "ios": "./assets/app-icons/Happy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Happy-android.png",
              "backgroundColor": "#1F1B3A"
            }
          },
          {
            "name": "InLove",
            "ios": "./assets/app-icons/InLove.png",
            "android": {
              "foregroundImage": "./assets/app-icons/InLove-android.png",
              "backgroundColor": "#5E4CCB"
            }
          },
          {
            "name": "Wink",
            "ios": "./assets/app-icons/Wink.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Wink-android.png",
              "backgroundColor": "#FF4D6D"
            }
          },
          {
            "name": "Sleepy",
            "ios": "./assets/app-icons/Sleepy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Sleepy-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Cool",
            "ios": "./assets/app-icons/Cool.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Cool-android.png",
              "backgroundColor": "#EE633C"
            }
          },
          {
            "name": "Party",
            "ios": "./assets/app-icons/Party.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Party-android.png",
              "backgroundColor": "#5E4CCB"
            }
          },
          {
            "name": "Shy",
            "ios": "./assets/app-icons/Shy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Shy-android.png",
              "backgroundColor": "#F1A3B6"
            }
          },
          {
            "name": "Kiss",
            "ios": "./assets/app-icons/Kiss.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Kiss-android.png",
              "backgroundColor": "#FFCDB1"
            }
          },
          {
            "name": "Starstruck",
            "ios": "./assets/app-icons/Starstruck.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Starstruck-android.png",
              "backgroundColor": "#FFE7A0"
            }
          },
          {
            "name": "MissingYou",
            "ios": "./assets/app-icons/MissingYou.png",
            "android": {
              "foregroundImage": "./assets/app-icons/MissingYou-android.png",
              "backgroundColor": "#B8D9FF"
            }
          },
          {
            "name": "Pixel",
            "ios": "./assets/app-icons/Pixel.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Pixel-android.png",
              "backgroundColor": "#1A1A1A"
            }
          },
          {
            "name": "Neon",
            "ios": "./assets/app-icons/Neon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Neon-android.png",
              "backgroundColor": "#0B0A14"
            }
          },
          {
            "name": "Duo",
            "ios": "./assets/app-icons/Duo.png",
            "android": {
              "foregroundImage": "./assets/app-icons/Duo-android.png",
              "backgroundColor": "#DCD1FF"
            }
          }
        ]
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "febe8159-67a5-41d8-988f-1b1291698f57"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/febe8159-67a5-41d8-988f-1b1291698f57",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
